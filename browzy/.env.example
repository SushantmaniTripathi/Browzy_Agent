# Copy to browzy/.env and fill in one speech-to-text key:

# Groq free tier (recommended, Whisper large-v3) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Sarvam AI (best for Hindi / Marathi code-mixing) — https://dashboard.sarvam.ai
# SARVAM_API_KEY=your_sarvam_key_here

# Optional: Language hint ("auto", "hi-IN", "mr-IN", "en-IN")
# BROWZY_STT_LANGUAGE=auto


