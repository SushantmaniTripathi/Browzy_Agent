{
  "manifest_version": 3,
  "name": "Browzy",
  "version": "1.0.0",
  "description": "Browzy — a local-AI side panel built into your browser.",
  "key": "",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:8764/*",
    "http://127.0.0.1:8764/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask Browzy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "open-browzy": {
      "suggested_key": {
        "default": "Alt+B"
      },
      "description": "Open the Browzy side panel"
    }
  }
}
